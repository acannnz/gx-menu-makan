<?xml version="1.0" encoding="utf-8"?>
<!-- Contoh tampilan di daftar widget (Android 12+); strukturnya sama dengan widget_menu.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp">

        <TextView
            android:id="@+id/w_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Kamis, 15 Okt"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w_rel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill"
            android:letterSpacing="0.06"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:text="HARI INI"
            android:textColor="@color/widget_accent"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_cols"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/w_col_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_col"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meal_pagi" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Pagi"
                    android:textColor="@color/widget_pagi"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_dot_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/widget_pagi"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_rice_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:text="Nasi Putih"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_rice_sp_0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:textColor="@color/widget_pagi"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_main_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1dp"
                android:text="• Tempe Goreng\n• Oseng Bakso"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_side_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:text="• Tumis Toge Ikan Asin"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_col_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_col_siang_now"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meal_siang" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Siang"
                    android:textColor="@color/widget_siang"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_dot_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/widget_siang"
                    android:textSize="9sp"
                    android:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_rice_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:text="Nasi Putih"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_rice_sp_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:textColor="@color/widget_siang"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_main_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1dp"
                android:text="• Korean Spicy Chicken"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_side_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:text="• Kimchi"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/w_col_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_col"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="7dp"
            android:paddingEnd="6dp"
            android:paddingBottom="7dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_meal_sore" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Sore"
                    android:textColor="@color/widget_sore"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/w_dot_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="●"
                    android:textColor="@color/widget_sore"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_rice_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:text="Nasi Putih"
                android:textColor="@color/widget_muted"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/w_rice_sp_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/widget_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="6dp"
                android:paddingTop="0.5dp"
                android:paddingEnd="6dp"
                android:paddingBottom="0.5dp"
                android:textColor="@color/widget_sore"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_main_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1dp"
                android:text="• Batagor\n• Somay Bandung"
                android:textColor="@color/widget_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/w_side_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:lineSpacingExtra="1dp"
                android:text="• Sambal Kacang"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/widget_empty"
        android:textColor="@color/widget_muted"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>
